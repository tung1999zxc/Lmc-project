{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/report/daily?send=1&slot=noon&force=1",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/report/daily?send=1&slot=end&force=1",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/care-camp/check",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/care-camp/cron",
      "schedule": "*/10 * * * *"
    }
  ]
}
